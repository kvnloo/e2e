{
  "name": "@e2e-dev/web",
  "version": "0.17.1",
  "description": "Web engine for e2e agentic end-to-end testing, built on Playwright",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "web-testing",
    "browser-testing",
    "browser-automation",
    "playwright",
    "chromium"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@e2e.com>",
    "Szymon Rybczak <szymon@e2e.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://e2e.com/docs/web",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine-entry.d.ts",
      "default": "./dist/engine-entry.js"
    }
  },
  "bin": {
    "e2e-web": "./dist/bin.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "playwright-core": "1.65.1"
  },
  "peerDependencies": {
    "@e2e-dev/core": ">=0.25.1 <1",
    "e2e": ">=0.25.1 <1"
  },
  "peerDependenciesMeta": {
    "e2e": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-dev/core": "workspace:*",
    "@napi-rs/image": "1.16.0",
    "@types/node": "26.6.11",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
